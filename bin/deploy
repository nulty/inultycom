#!/usr/bin/env bash
# Build, push and deploy to inulty.com with Kamal.
# The registry token is read from `pass show do-registry` by .kamal/secrets.
set -euo pipefail
cd "$(dirname "$0")/.."

if ! command -v pass >/dev/null; then
  echo "pass is not installed; .kamal/secrets reads the registry token from 'pass show do-registry'" >&2
  exit 1
fi

exec kamal deploy "$@"
